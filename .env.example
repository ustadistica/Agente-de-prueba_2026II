# Copia este archivo como .env y coloca tus valores reales.
# NUNCA subas el archivo .env al repositorio.

# --- Proveedor LLM (compatible con API de OpenAI) ---
# Opcion 1 - Google Gemini (endpoint compatible OpenAI):
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=tu_clave_de_gemini
LLM_MODEL=gemini-2.0-flash

# Opcion 2 - OpenAI directo:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Opcion 3 - Modelo local con Ollama:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# LLM_MODEL=llama3.1:8b

# Temperatura del modelo (0 = mas determinista)
LLM_TEMPERATURE=0.2
